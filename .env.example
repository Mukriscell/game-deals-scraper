# Obtén tu API key gratis en: https://isthereanydeal.com/dev/app/
ITAD_API_KEY=tu_itad_api_key_aqui

# Obtén tu API key gratis en: https://gg.deals/api/
GGDEALS_API_KEY=tu_ggdeals_api_key_aqui

# Entorno: 'production' activa HTTPS-only cookies y HSTS. Omitir en desarrollo.
# FLASK_ENV=production

# Habilita debug mode SOLO en desarrollo local (nunca en producción)
# FLASK_DEBUG=true

# Clave secreta para firmar las sesiones Flask — genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu_secret_key_aqui

# Credenciales del panel de administración (acceso en /admin/login)
ADMIN_EMAIL=admin@example.com

# ADMIN_PASSWORD_HASH (recomendado): genera el hash con:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('TuPassword'))"
ADMIN_PASSWORD_HASH=pbkdf2:sha256:...hash_generado_aqui...

# ADMIN_PASSWORD (legacy, texto plano — reemplaza por ADMIN_PASSWORD_HASH):
# ADMIN_PASSWORD=tu_password_admin_aqui

# Configuración SMTP para envío de códigos de verificación al registrarse
# Gmail: usa una App Password (no tu contraseña normal).
#   Activa 2FA → Ajustes Google → Seguridad → Contraseñas de aplicación
# Outlook/Hotmail: MAIL_SERVER=smtp.office365.com  MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_aqui
MAIL_FROM=GAMEDEALS <tu_correo@gmail.com>

# API key gratuita de RAWG (juegos tendencia): https://rawg.io/apidocs
RAWG_API_KEY=tu_rawg_api_key_aqui

# Steam Web API key (para importar biblioteca de Steam): https://steamcommunity.com/dev/apikey
# Sin esta variable el botón de importar Steam estará desactivado.
# STEAM_API_KEY=tu_steam_api_key_aqui

# Conexión a PostgreSQL (reemplaza SQLite en producción)
# Opciones gratuitas: Neon (neon.tech) o Supabase (supabase.com)
# Formato: postgresql://usuario:contraseña@host:5432/nombre_base_de_datos
DATABASE_URL=postgresql://usuario:contraseña@host:5432/balato

# Redis para rate limiting compartido entre múltiples workers de Gunicorn (opcional)
# Sin esta variable el rate limiter opera por proceso — funciona con 1 worker.
# Opciones gratuitas: Upstash (upstash.com) o Railway Redis
# Formato: redis://usuario:contraseña@host:6379
# REDIS_URL=redis://usuario:contraseña@host:6379

# ── Afiliados (opcional) ──────────────────────────────────────────────────────
# Cada variable activa el tracking automático para esa tienda.
# Regístrate en el programa de afiliados de cada tienda y pega tu código aquí.
# Las tiendas sin código configurado muestran el link original sin cambios.
#
# Fanatical (~6%) — programa en Impact.com: https://www.fanatical.com/affiliates
# AFFILIATE_FANATICAL=tu_id_fanatical
#
# Humble Bundle (~6–15%) — programa propio: https://www.humblebundle.com/affiliates
# AFFILIATE_HUMBLE=tu_id_humble
#
# Green Man Gaming (~5%) — programa en CJ Affiliate / Awin
# AFFILIATE_GMG=tu_id_gmg
#
# Eneba (~7%) — programa propio: https://www.eneba.com/affiliate
# AFFILIATE_ENEBA=tu_id_eneba
#
# G2A — programa propio: https://www.g2a.com/goldmine
# AFFILIATE_G2A=tu_id_g2a
#
# Amazon Associates (~1–4%): https://affiliate-program.amazon.com
# Para EE.UU. el código tiene formato "tusite-20"
# AFFILIATE_AMAZON=tusite-20
#
# WinGameStore — programa propio: https://www.wingamestore.com/affiliate/
# AFFILIATE_WINGAMESTORE=tu_id_wingamestore
#
# GamersGate: https://www.gamersgate.com/affiliate/
# AFFILIATE_GAMERSGATE=tu_id_gamersgate
#
# GameBillet: https://www.gamebillet.com/affiliate
# AFFILIATE_GAMEBILLET=tu_id_gamebillet
#
# IndieGala: https://www.indiegala.com/affiliates
# AFFILIATE_INDIEGALA=tu_id_indiegala
#
# Nuuvem (mercado latinoamericano): https://www.nuuvem.com/afiliados
# AFFILIATE_NUUVEM=tu_id_nuuvem
#
# DLGamer: https://www.dlgamer.com/affiliate
# AFFILIATE_DLGAMER=tu_id_dlgamer
#
# Gamesplanet: https://www.gamesplanet.com/affiliate
# AFFILIATE_GAMESPLANET=tu_id_gamesplanet
#
# 2game: https://www.2game.com/affiliate
# AFFILIATE_2GAME=tu_id_2game
