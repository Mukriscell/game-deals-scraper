# Obtén tu API key gratis en: https://isthereanydeal.com/dev/app/
ITAD_API_KEY=tu_itad_api_key_aqui

# Obtén tu API key gratis en: https://gg.deals/api/
GGDEALS_API_KEY=tu_ggdeals_api_key_aqui

# Clave secreta para firmar las sesiones Flask — genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=tu_secret_key_aqui

# Credenciales del panel de administración (acceso en /admin/login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=tu_password_admin_aqui

# Configuración SMTP para envío de códigos de verificación al registrarse
# Gmail: usa una App Password (no tu contraseña normal).
#   Activa 2FA → Ajustes Google → Seguridad → Contraseñas de aplicación
# Outlook/Hotmail: MAIL_SERVER=smtp.office365.com  MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password_aqui
MAIL_FROM=GAMEDEALS <tu_correo@gmail.com>

# API key gratuita de RAWG (juegos tendencia): https://rawg.io/apidocs
RAWG_API_KEY=tu_rawg_api_key_aqui
